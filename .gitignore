# Python bytecode and local environments
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Packaging output (keep the PyInstaller spec in version control)
build/
dist/
*.egg-info/

# Customer inputs and generated reports stay local.
# Only the explicitly synthetic example belongs in the repository.
*.xlsx
*.xls
*.xlsm
~$*
!examples/sample_customers.xlsx

# Local configuration and editor files
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
Thumbs.db

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
